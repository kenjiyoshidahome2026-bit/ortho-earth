{
	"name": "@ortho-earth/cesium",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "CesiumJS API on ortho-earth: a Cesium namespace (Viewer, Camera, entities, data sources, clock, 3D Tiles, picking) that draws with @ortho-earth/globe. Math, time, Entity/Property and CZML parsing come from @cesium/engine unchanged.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-cesium.mjs"
	},
	"dependencies": {
		"@cesium/core": "0.1.0",
		"@cesium/engine": "26.4.0",
		"@cesium/widgets": "16.3.0",
		"lerc": "^4.2.0"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.0.0",
		"@ortho-earth/voxel": "^0.6.0",
		"@ortho-earth/ktx2": "^0.1.0"
	},
	"keywords": [
		"cesium",
		"cesiumjs",
		"migration",
		"globe",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "sdk/cesium"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"dist",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"peerDependenciesMeta": {
		"@ortho-earth/voxel": {
			"optional": true
		},
		"@ortho-earth/ktx2": {
			"optional": true
		}
	}
}

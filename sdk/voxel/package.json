{
	"name": "@ortho-earth/voxel",
	"version": "0.6.1",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "Voxel grids for @ortho-earth/globe as the map.addData kind \"voxel\" (box, region or cylinder grids, scalar or RGBA): ray-marched as blocks, volume or isosurface, with clipping, scene depth, picking and a worker reader. WebGPU or WebGL2.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-voxel.mjs && node tests/t-sources.mjs"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.2.0"
	},
	"keywords": ["voxel", "volume-rendering", "ray-marching", "isosurface", "3d-grid", "webgpu", "webgl2", "globe", "ortho-earth"],
	"repository": { "type": "git", "url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git", "directory": "sdk/voxel" },
	"homepage": "https://www.ortho-earth.com/",
	"files": ["src", "dist", "LICENSE", "README.md"]
}

{
	"name": "@ortho-earth/splat",
	"version": "0.6.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "Gaussian splats for @ortho-earth/globe as the map.addData kind \"splat\" (.ply, .splat, .spz, .ksplat, .sog): WebGPU with spherical harmonics, GPU sort and LoD, WebGL2 fallback, scene depth, picking and a worker reader.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-splat.mjs"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.0.2"
	},
	"keywords": ["gaussian-splatting", "3dgs", "splat", "ply", "spz", "ksplat", "sog", "webgpu", "globe", "ortho-earth"],
	"repository": { "type": "git", "url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git", "directory": "sdk/splat" },
	"homepage": "https://www.ortho-earth.com/",
	"files": ["src", "dist", "LICENSE", "README.md"]
}

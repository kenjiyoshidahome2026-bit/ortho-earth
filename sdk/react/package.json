{
	"name": "@ortho-earth/react",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "React bindings for @ortho-earth/globe: <Globe> creates the map, useGlobe() hands it to children, <Source>/<Layer> mirror addSource/addLayer, <Data> wraps map.addData, <Marker> is the DOM marker, useGlobeEvent() subscribes to map events. No JSX runtime required.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-react.mjs"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.0.0",
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@ortho-earth/globe": "*",
		"react": "^19.3.0",
		"react-dom": "^19.3.1"
	},
	"keywords": ["react", "globe", "maplibre", "ortho-earth"],
	"repository": { "type": "git", "url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git", "directory": "sdk/react" },
	"homepage": "https://www.ortho-earth.com/",
	"files": ["src", "dist", "LICENSE", "README.md"]
}

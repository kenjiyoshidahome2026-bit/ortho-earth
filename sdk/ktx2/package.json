{
	"name": "@ortho-earth/ktx2",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "KTX2 / Basis Universal texture transcoder plugin for @ortho-earth/globe: a worker-side transcode() (basis_universal WASM, loaded on first use) turns KHR_texture_basisu textures in glb models and 3D Tiles into RGBA.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./transcode": "./src/transcode.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-ktx2.mjs"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.0.0"
	},
	"keywords": [
		"ktx2",
		"basis",
		"basis-universal",
		"texture",
		"gltf",
		"globe",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "sdk/ktx2"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"dist",
		"LICENSE",
		"README.md"
	]
}

{
	"name": "@ortho-earth/gmaps",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "Google Maps JavaScript API on MapLibre GL: a google.maps namespace (Map, Marker, AdvancedMarkerElement, InfoWindow, Polyline, Polygon, Circle, Rectangle, Data, event, geometry) that translates to any maplibregl namespace, by default @ortho-earth/globe/maplibre.",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./globe": "./src/globe.ts"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p .",
		"prepack": "node ../../scripts/pack-ts.mjs pre",
		"postpack": "node ../../scripts/pack-ts.mjs post",
		"test": "node tests/t-gmaps.mjs"
	},
	"peerDependencies": {
		"@ortho-earth/globe": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@ortho-earth/globe": { "optional": true }
	},
	"keywords": [
		"google-maps",
		"maplibre",
		"migration",
		"globe",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "sdk/gmaps"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"dist",
		"LICENSE",
		"README.md"
	]
}

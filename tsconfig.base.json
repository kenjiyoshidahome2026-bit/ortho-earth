{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"declaration": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"types": []
	}
}

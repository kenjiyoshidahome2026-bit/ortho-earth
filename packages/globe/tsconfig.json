{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		// loaders.gl の型は Node の大域を持ち込む＝globe が使う名前だけの宣言（types/loaders.gl/）で解く（src/mesh-loaders.ts・i3s-loaders.ts）
		"paths": { "@loaders.gl/*": ["./types/loaders.gl/*.d.ts"] }
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/gintbakeworker.ts",
		"src/meshworker.ts",
		"src/meshdecoder.ts",
		"src/model-worker.ts",
		"src/copc-worker.ts",
		"src/vtextrude-worker.ts",
		"src/worker.ts",
		"src/renderworker.ts",
		"src/vtdraw-worker.ts",
		"src/rastertiles-worker.ts",
		"src/imagequad-worker.ts",
		"src/iiif-worker.ts",
		"src/columnar/worker.ts"]
}

{
	"name": "@ortho-earth/globe",
	"version": "1.2.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "A 3D globe for the web: createGlobe() draws the whole Earth with WebGPU (WebGL2 fallback) and takes your data through a MapLibre-style API. No API key, no server of your own.",
	"types": "./globe.d.ts",
	"exports": {
		".": {
			"types": "./globe.d.ts",
			"default": "./src/globe.js"
		},
		"./scripts/*": "./scripts/*",
		"./*": "./src/*"
	},
	"imports": {
		"#extra-roles": "./src/worker-roles-extra.js"
	},
	"dependencies": {
		"@loaders.gl/3d-tiles": "^4.3.0",
		"@loaders.gl/core": "^4.3.0",
		"@loaders.gl/draco": "^4.3.0",
		"@loaders.gl/gltf": "^4.3.0",
		"@loaders.gl/i3s": "^4.4.3",
		"@ortho-earth/core": "^1.3.0",
		"@ortho-earth/ephem": "^1.0.0",
		"earcut": "^3.2.3",
		"fzstd": "^0.1.1",
		"geoedit": "^0.3.0",
		"geopbf": "^1.14.0",
		"native-bucket": "^1.0.0"
	},
	"devDependencies": {
		"quiet-mono": "^1.0.0",
		"sass": "^1.93.0"
	},
	"scripts": {
		"build:css": "node scripts/build-css.mjs",
		"prepack": "node scripts/build-css.mjs",
		"test": "node tests/zoomscale.mjs && node tests/mlfacade.mjs && node tests/internal-callers.mjs && node tests/expr-golden.mjs && node tests/mlcompat.mjs && node tests/vtextrude.mjs",
		"verify": "node scripts/build-css.mjs --check && npm run verify:regionless && npm run verify:ui && npm run verify:webgpu",
		"verify:ui": "node scripts/verify-ui.mjs",
		"verify:webgpu": "node scripts/verify-webgpu.mjs",
		"verify:nocoi": "node scripts/verify-nocoi.mjs",
		"verify:net": "node scripts/verify-net.mjs",
		"verify:regionless": "node scripts/verify-regionless.mjs",
		"verify:npm": "node scripts/verify-npm.mjs"
	},
	"keywords": [
		"globe",
		"map",
		"3d",
		"webgl",
		"webgpu",
		"3d-tiles",
		"i3s",
		"terrain",
		"gis",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "packages/globe"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"globe.d.ts",
		"scripts",
		"LICENSE",
		"README.md"
	],
	"sideEffects": [
		"*.css",
		"*.scss",
		"./src/worker.js",
		"./src/renderworker.js",
		"./src/meshworker.js",
		"./src/meshdecoder.js",
		"./src/gintbakeworker.js",
		"./src/rastertiles-worker.js",
		"./src/imagequad-worker.js",
		"./src/model-worker.js",
		"./src/vtextrude-worker.js",
		"./src/gadgets/parquet-worker.js"
	]
}

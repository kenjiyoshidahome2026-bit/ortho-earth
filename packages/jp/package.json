{
	"name": "@ortho-earth/jp",
	"version": "0.0.1",
	"license": "GPL-3.0-or-later",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./dtm": "./src/dtm.ts",
		"./region": "./src/region.ts",
		"./poi": "./src/poi.ts",
		"./search-gsi": "./src/search-gsi.ts",
		"./n02": "./src/n02.ts",
		"./estat": "./src/estat.ts",

{
	"name": "native-bucket",
	"version": "1.0.0",
	"description": "native-bucket — a bridge between Cloudflare R2/Workers and browser IndexedDB for heavy binary datasets (GIS archives, ZIP, large assets): proxied Fetch with progress, R2 bucket listing/upload, persistent Cache. Browser-only. MIT.",
	"keywords": [
		"cloudflare",
		"r2",
		"workers",
		"indexeddb",
		"cache",
		"binary",
		"browser"
	],
	"homepage": "https://www.ortho-earth.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "packages/native-bucket"
	},
	"author": "Kenji Yoshida <kenji.yoshida.home.2026@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"dependencies": {
		"geopbf": "^1.13.1"
	},
	"devDependencies": {
		"sass-embedded": "^1.99.0",
		"terser": "^5.0.0",
		"vite": "^5.0.0",
		"wrangler": "^4.84.1"
	},
	"scripts": {
		"dev": "vite --config vite.demo.config.js",
		"build": "vite build --config vite.demo.config.js && vite build",
		"preview": "vite preview --config vite.demo.config.js",
		"deploy": "npm run build && npx wrangler deploy",
		"summary": "repomix --style markdown --output project_summary.md",
		"test:proxy": "node tests/t-proxy.mjs",
		"test:tellus": "node tests/t-tellus.mjs",
		"mirror": "node scripts/mirror.mjs"
	},
	"sideEffects": false,
	"files": [
		"src",
		"LICENSE",
		"README.md"
	]
}

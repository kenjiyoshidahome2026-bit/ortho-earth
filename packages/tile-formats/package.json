{
	"name": "@ortho-earth/tile-formats",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "MLT (MapLibre Tile) plugin for @ortho-earth/core: registers the \"mlt\" tile format (vector source encoding \"mlt\" / PMTiles tileType 6) on top of @maplibre/mlt, decoded lazily on the first MLT tile.",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js",
		"./register": "./src/register.js",
		"./format": "./src/format.js",
		"./decode": "./src/mlt.js",
		"./node-hook": "./src/node-hook.mjs",
		"./node-register": "./src/node-register.mjs",
		"./scripts/*": "./scripts/*"
	},
	"sideEffects": [
		"./src/register.js",
		"./src/node-register.mjs"
	],
	"scripts": {
		"test": "node tests/t-mlt.mjs",
		"mvt2mlt": "node scripts/mvt2mlt.mjs"
	},
	"dependencies": {
		"@maplibre/mlt": "^1.3.0"
	},
	"peerDependencies": {
		"@ortho-earth/core": "^1.4.0"
	},
	"devDependencies": {
		"@ortho-earth/core": "*",
		"geopbf": "*",
		"pmtiles": "*"
	},
	"keywords": [
		"mlt",
		"maplibre-tile",
		"vector-tiles",
		"mvt",
		"pmtiles",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "packages/tile-formats"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"scripts",
		"LICENSE",
		"README.md"
	]
}

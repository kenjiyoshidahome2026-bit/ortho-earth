{
	"name": "@ortho-earth/tile-formats",
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "Format plugins for @ortho-earth/core and @ortho-earth/globe: MLT (MapLibre Tile) as the \"mlt\" tile format on top of @maplibre/mlt, and LAZ point records for COPC point clouds on top of laz-perf — each decoder loaded lazily on first use.",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js",
		"./register": "./src/register.js",
		"./format": "./src/format.js",
		"./decode": "./src/mlt.js",
		"./pointcloud": "./src/pointcloud.js",
		"./laz": "./src/laz.js",
		"./node-hook": "./src/node-hook.mjs",
		"./node-register": "./src/node-register.mjs",
		"./scripts/*": "./scripts/*"
	},
	"sideEffects": [
		"./src/register.js",
		"./src/node-register.mjs"
	],
	"scripts": {
		"test": "node tests/t-mlt.mjs && node tests/t-laz.mjs",
		"mvt2mlt": "node scripts/mvt2mlt.mjs"
	},
	"dependencies": {
		"@maplibre/mlt": "^1.3.0",
		"laz-perf": "^0.0.7"
	},
	"peerDependencies": {
		"@ortho-earth/core": "^1.4.0"
	},
	"devDependencies": {
		"@ortho-earth/core": "*",
		"geopbf": "*",
		"pmtiles": "*"
	},
	"keywords": [
		"mlt",
		"maplibre-tile",
		"vector-tiles",
		"mvt",
		"pmtiles",
		"laz",
		"copc",
		"point-cloud",
		"ortho-earth"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "packages/tile-formats"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": [
		"src",
		"scripts",
		"LICENSE",
		"README.md"
	]
}

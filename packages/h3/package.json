	"exports": {
		".": "./src/index.js",
		"./core": "./src/core.js"
	},
	"sideEffects": false,
	"scripts": {
		"test": "node tests/t-h3.mjs"
	},
	"dependencies": {
		"h3-js": "^4.5.0"
	},
	"peerDependencies": {
		"@ortho-earth/core": "^1.4.0"
	},
	"devDependencies": {
		"@ortho-earth/core": "*"
	},
	"keywords": ["h3", "hexagon", "binning", "globe", "ortho-earth"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenjiyoshidahome2026-bit/ortho-earth.git",
		"directory": "packages/h3"
	},
	"homepage": "https://www.ortho-earth.com/",
	"files": ["src", "LICENSE", "README.md"]
}

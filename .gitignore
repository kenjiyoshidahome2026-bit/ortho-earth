# .gitignore (ルート直下)

# 依存関係
node_modules/
npm-debug.log*

# ビルド出力
# verify:npm が package の dir に残す npm pack の tarball（段 5-9）
packages/*/*.tgz
sdk/*/*.tgz
dist/
dist-tsc/
# npm run coverage の出力（scripts/coverage.mjs）
/coverage/
build/
# 国別DB v2 の組み立て（Node CLI と uploader で共用）＝ソースなので追跡
!packages/world/build/
stats.html
# 焼きスクリプトの出力（uploader のボタンが dev の /@fs で読んで R2 へ上げる＝bake-out/alt・bake-out/catalog・2026-10-15）
/bake-out/
apps/japan-map/r10-src/
# 環境変数
.env
.env.local

# OSのシステムファイル
.DS_Store
Thumbs.db

project_summary.txt
project_summary.md
dust-box/
.claude/worktrees/

packages/gdal-geopbf/
.wrangler/

# 再生成可能な中間生成物（extract-geojson.js / make-catalog-json.js の出力・計31MB）
apps/gishub-jp/scripts/catalog-geojson.csv
apps/gishub-jp/scripts/catalog.json
.dev.vars

# USGS 地震カタログの月別 CSV キャッシュ（apps/quakes/scripts/usgs-quakes-build.mjs）
.cache/
# 地震ビューア（apps/quakes/index.html）の dev 用データ＝apps/quakes/scripts/usgs-quakes-build.mjs で再生成できる（25MB）
apps/quakes/public/dev/*.geopbf
# USGS 地震データ本体（apps/quakes/scripts/usgs-quakes-build.mjs で再生成できる・25MB）
/usgs-quakes-*.geopbf
/usgs-quakes-*.geopbf.json
# Claude の作業出力（プレビュー画像など）
Claude outputs/

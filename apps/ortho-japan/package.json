{
	"name": "ortho-japan",
	"version": "1.0.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"verify:ui": "node scripts/verify-ui.mjs",
		"verify:webgpu": "node scripts/verify-webgpu.mjs",
		"deploy": "vite build && rm -rf dist/site/japan/moj-local && find dist/site -name .DS_Store -delete && wrangler deploy",
		"preview:prod": "vite build && rm -rf dist/site/japan/moj-local && wrangler dev",
		"verify:nocoi": "node scripts/verify-nocoi.mjs",
		"build:lib": "vite build --config vite.lib.config.js",
		"verify:lib": "node scripts/verify-lib.mjs",
		"pack:sdk": "node scripts/pack-sdk.mjs"
	},
	"dependencies": {
		"ortho-core": "*",
		"geopbf": "*",
		"altpbf": "*",
		"@loaders.gl/core": "^4.3.0",
		"@loaders.gl/3d-tiles": "^4.3.0",
		"@loaders.gl/draco": "^4.3.0",
		"quiet-mono": "*",
		"ephem": "*"
	},
	"devDependencies": {
		"vite": "^5.0.0"
	}
}
